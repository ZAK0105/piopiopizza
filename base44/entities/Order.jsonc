{
  "name": "Order",
  "type": "object",
  "properties": {
    "number": { "type": "string", "description": "Order number shown to staff and customer, e.g. PP-1042" },
    "track_code": { "type": "string", "description": "Random code the customer uses to follow the order" },
    "status": { "type": "string", "enum": ["received", "oven", "ready", "out", "done", "cancelled"], "enumColors": ["blue", "yellow", "green", "purple", "gray", "red"], "default": "received" },
    "mode": { "type": "string", "enum": ["delivery", "pickup"] },
    "address": { "type": "string" },
    "customer_name": { "type": "string" },
    "customer_phone": { "type": "string", "description": "Norwegian number, +47 412 34 567" },
    "note": { "type": "string", "description": "Customer's message for the driver" },
    "lines": { "type": "array", "description": "Pizzas", "items": { "type": "object", "properties": {
      "id": { "type": "string" }, "name": { "type": "string" }, "size": { "type": "string" },
      "tops": { "type": "array", "items": { "type": "string" } }, "qty": { "type": "number" }, "unit": { "type": "number" } } } },
    "extras": { "type": "array", "description": "Sides, dips, drinks, desserts", "items": { "type": "object", "properties": {
      "id": { "type": "string" }, "name": { "type": "string" }, "qty": { "type": "number" }, "unit": { "type": "number" } } } },
    "subtotal": { "type": "number" },
    "fee": { "type": "number", "description": "Delivery fee" },
    "total": { "type": "number", "description": "NOK, including delivery fee" },
    "payment_method": { "type": "string", "enum": ["vipps", "card"] },
    "times": { "type": "object", "description": "When each status was reached (epoch ms)", "additionalProperties": true },
    "placed_at": { "type": "number", "description": "When the order was placed (epoch ms)" },
    "demo": { "type": "boolean", "default": false, "description": "Demo order, removable from Settings" },
    "dest": { "type": "object", "description": "Delivery point {lat, lng} for the map", "additionalProperties": true },
    "driver": { "type": "object", "description": "Assigned driver {id, name, phone, vehicle}", "additionalProperties": true },
    "pos": { "type": "object", "description": "Driver's last position {lat, lng, at} while out for delivery", "additionalProperties": true }
  },
  "required": ["number", "status", "mode", "total", "payment_method", "placed_at"],
  // Staff only. Customers place and follow orders through the placeOrder / trackOrder functions.
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
